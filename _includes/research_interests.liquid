{% assign items = site.research_interests %}
{% for item in items %}
  {% if item.collapsible == false %}
    {{ item.content | markdownify }}
  {% else %}
    <details>
      <summary><strong>{{ item.title }}</strong></summary>
      <div class="research-interest-body">{{ item.content | markdownify }}</div>
    </details>
  {% endif %}
{% endfor %}
<br>
